# ============================================
# Shopify App (автозаполняется Shopify CLI при `shopify app dev`)
# Эти значения не трогай — CLI их сам подставит
# ============================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions
SHOP_CUSTOM_DOMAIN=

# ============================================
# SMTP — оставь пустым для DEV (auto-Ethereal)
# Заполни для PROD (Resend / SendGrid / SES)
# ============================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM=Your Store <hello@yourdomain.com>

# ============================================
# Flow webhook secret — ОБЯЗАТЕЛЬНО поменяй!
# Сгенерируй: openssl rand -hex 32
# ============================================
FLOW_SECRET=CHANGE_ME_TO_RANDOM_STRING

# ============================================
# Твой домен магазина
# ============================================
STORE_URL=https://your-store.myshopify.com